{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./profile.schema.json",
  "title": "Composable Data Stack Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "cds/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "Profile"
    },
    "extends": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "One or more parent profile references (profile name or relative path) this profile composes from, left-to-right with later parents winning, then this profile winning over all parents. Resolved before validation; the resolved profile never contains this field."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "environment"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "enum": ["local", "development", "staging", "production"],
          "description": "Declared support level. Read directly by cli/security.py's profile classification, do not infer this from the name."
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "modules"],
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "networks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/network"
              }
            }
          }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/moduleInstance"
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": {
                  "type": "string"
                }
              }
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/secretValue"
              }
            }
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contracts": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/outputContract"
              }
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional, module-agnostic opt-in for tiered log retention and structured event shipping. See docs/observability.md.",
          "properties": {
            "logShipping": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "retention": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "rawDays": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "Short retention window for raw container logs."
                    },
                    "structuredDays": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "Longer retention window for structured, high-value events (run status, failures, health transitions)."
                    }
                  }
                },
                "sink": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["contractRef"],
                  "description": "Optional. Only set this to pin log shipping to a specific module's log-sink contract; omit to enable shipping without naming a provider.",
                  "properties": {
                    "contractRef": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
                    }
                  }
                }
              }
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "waivers": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "plaintextEndpointExposure": {
                  "$ref": "#/$defs/plaintextEndpointExposureWaiver"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "moduleInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "version", "enabled", "config"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "uniqueItems": true
        },
        "config": {
          "type": "object"
        }
      }
    },
    "secretValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env", "required"],
      "properties": {
        "env": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from"],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "driver": {
          "type": "string",
          "default": "bridge"
        }
      }
    },
    "plaintextEndpointExposureWaiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
