{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./profile.schema.json",
  "title": "Composable Data Stack Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "cds/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "Profile"
    },
    "extends": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "One or more parent profile references (profile name or relative path) this profile composes from, left-to-right with later parents winning, then this profile winning over all parents. Resolved before validation; the resolved profile never contains this field."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "environment"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "enum": ["local", "development", "staging", "production"],
          "description": "Declared support level. Read directly by cli/security.py's profile classification, do not infer this from the name."
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "modules"],
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "networks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/network"
              }
            }
          }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/moduleInstance"
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": {
                  "type": "string"
                }
              }
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/secretValue"
              }
            }
          }
        },
        "certificates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["values"],
          "description": "Certificate/key reference aliases mapping to externally managed material (issue #578). CDS never generates, reads, or embeds certificate or key material: each alias names the two environment variables a secret/cert provider supplies at runtime, and module config references the halves as certificates.<alias>.cert / certificates.<alias>.key, which render as ${VAR} runtime placeholders exactly like secrets.",
          "properties": {
            "values": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/certificateValue"
              }
            }
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contracts": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/outputContract"
              }
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional, module-agnostic opt-in for tiered log retention and structured event shipping. See docs/observability.md.",
          "properties": {
            "logShipping": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "retention": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "rawDays": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "Short retention window for raw container logs."
                    },
                    "structuredDays": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "Longer retention window for structured, high-value events (run status, failures, health transitions)."
                    }
                  }
                },
                "sink": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["contractRef"],
                  "description": "Optional. Only set this to pin log shipping to a specific module's log-sink contract; omit to enable shipping without naming a provider.",
                  "properties": {
                    "contractRef": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
                    }
                  }
                }
              }
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runtime": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "confinement": {
                  "$ref": "#/$defs/runtimeConfinement"
                }
              }
            },
            "waivers": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "plaintextEndpointExposure": {
                  "$ref": "#/$defs/plaintextEndpointExposureWaiver"
                },
                "runtimePolicy": {
                  "$ref": "#/$defs/runtimePolicyWaiver"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "moduleInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "version", "enabled", "config"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "uniqueItems": true
        },
        "config": {
          "type": "object"
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "confinement": {
              "$ref": "#/$defs/runtimeConfinement"
            }
          }
        }
      }
    },
    "runtimeConfinement": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declarative runtime confinement rendered into each service's security_opt. See docs/runtime-confinement.md.",
      "properties": {
        "seccomp": {
          "type": "string",
          "description": "'default', 'unconfined' or 'file:<JSON profile relative to the profile directory>'."
        },
        "apparmor": {
          "type": "string",
          "description": "'runtime/default', 'unconfined' or the name of a host-loaded AppArmor profile."
        },
        "selinux": {
          "description": "'disable' or a list of labels such as 'type:container_t'.",
          "type": ["string", "array"]
        }
      }
    },
    "secretValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env", "required"],
      "properties": {
        "env": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "certificateValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certEnv", "keyEnv"],
      "properties": {
        "certEnv": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "Environment variable name (no value) supplied by the secret/cert provider at runtime that holds or materializes the certificate."
        },
        "keyEnv": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "Environment variable name (no value) supplied by the secret/cert provider at runtime that holds or materializes the private key. CDS never reads or renders the key material itself."
        }
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from"],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "driver": {
          "type": "string",
          "default": "bridge"
        }
      }
    },
    "runtimePolicyWaiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "checks"],
      "description": "Waives individual CDS-SEC-090 runtime-policy checks (production profiles only) for every service, e.g. when images set a non-root USER that CDS cannot see.",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["capDrop", "noNewPrivileges", "nonRootUser", "readOnlyRootFilesystem"]
          }
        }
      }
    },
    "plaintextEndpointExposureWaiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Must contain at least one non-whitespace character; cli/security.py strips and treats an all-whitespace reason as unset (no waiver applied, so CDS-SEC-074 still fires), so a schema that only enforced minLength: 1 would silently accept a value the code then discards."
        }
      }
    }
  }
}
