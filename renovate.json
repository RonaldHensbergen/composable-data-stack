{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track pip pins in Dagster entrypoint script",
      "matchStrings": [
        "(?<depName>dagster-postgres)==(?<currentValue>\\S+)",
        "(?<depName>dagster-mysql)==(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "pypi",
      "managerFilePatterns": [
        "/^images/dagster/entrypoint\\.sh$/"
      ]
    },
    {
      "customType": "regex",
      "description": "Track Docker image tags in module definitions",
      "matchStrings": [
        "image:\\s*(?<depName>[\\w./-]+):(?<currentValue>[\\w.-]+)"
      ],
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/^modules/.+/module\\.yaml$/"
      ]
    },
    {
      "customType": "regex",
      "description": "Track the pinned image.tag registry default in modules/orchestration/dagster/module.yaml against the dagster PyPI version, since it must stay in sync with the dagster== pin in images/dagster/requirements.txt for `--image-source registry`/`cds config set image.source registry` to pull a valid published tag",
      "matchStrings": [
        "# cds-registry-tag-source: pypi/dagster[^\\n]*(?:\\n\\s*#[^\\n]*)*\\n\\s*default:\\s*\"(?<currentValue>[\\w.-]+)\""
      ],
      "depNameTemplate": "dagster",
      "datasourceTemplate": "pypi",
      "managerFilePatterns": [
        "/^modules/orchestration/dagster/module\\.yaml$/"
      ]
    },
    {
      "customType": "regex",
      "description": "Track the pinned image.tag registry default in modules/bi/superset/module.yaml against the apache/superset Docker tag, since it must stay in sync with the apache/superset base pinned in images/superset/base/Dockerfile for `--image-source registry`/`cds config set image.source registry` to pull a valid published tag",
      "matchStrings": [
        "# cds-registry-tag-source: docker/apache/superset[^\\n]*(?:\\n\\s*#[^\\n]*)*\\n\\s*default:\\s*\"(?<currentValue>[\\w.-]+)\""
      ],
      "depNameTemplate": "apache/superset",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/^modules/bi/superset/module\\.yaml$/"
      ]
    },
    {
      "customType": "regex",
      "description": "Keep the documented minimum Python version in docs/support-policy.md in sync with pyproject.toml's requires-python",
      "matchStrings": [
        "requires-python\\s*=\\s*\">=(?<currentValue>\\d+\\.\\d+)\"",
        "\\|\\s*Python\\s*\\|\\s*(?<currentValue>\\d+\\.\\d+)\\+\\s*\\|"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "endoflife-date",
      "versioningTemplate": "loose",
      "managerFilePatterns": [
        "/^pyproject\\.toml$/",
        "/^docs/support-policy\\.md$/"
      ]
    },
    {
      "customType": "regex",
      "description": "Track the Trivy CLI version pinned via trivy-action's version: input, since the action's own bundled default (which Renovate cannot see) lags behind the latest Trivy release",
      "matchStrings": [
        "version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s*\\n\\s*image-ref:"
      ],
      "depNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases",
      "managerFilePatterns": [
        "/^\\.github/workflows/image-security-scan\\.yml$/",
        "/^\\.github/workflows/publish-images\\.yml$/"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Do not update local development image tags",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "local/dagster"
      ],
      "enabled": false
    },
    {
      "description": "Only bump Python minimum version at cycle level (minor/major), not on patch releases — requires-python tracks supported cycles, not specific patches",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    },
    {
      "groupName": "all dependencies",
      "matchPackageNames": [
        "/.*/"
      ]
    }
  ]
}
